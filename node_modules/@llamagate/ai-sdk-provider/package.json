{
  "name": "@llamagate/ai-sdk-provider",
  "version": "0.1.0",
  "description": "LlamaGate provider for the Vercel AI SDK - Access 26+ open-source LLMs with OpenAI-compatible API",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "ai",
    "ai-sdk",
    "vercel",
    "llamagate",
    "llm",
    "openai-compatible",
    "llama",
    "qwen",
    "deepseek",
    "mistral",
    "embedding"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/llamagate/llama-gate",
    "directory": "apps/ai-sdk-provider"
  },
  "homepage": "https://llamagate.dev",
  "bugs": {
    "url": "https://github.com/llamagate/llama-gate/issues"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^0.2.0",
    "@ai-sdk/provider": "^1.1.0",
    "@ai-sdk/provider-utils": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "ai": ">=4.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
